# Genuine public-media discovery through an open Mastodon server. For the demo,
# post the consenting reference image under a shared multi-post hashtag and put it here.
FACEPROOF_MASTODON_INSTANCE=https://mastodon.social
FACEPROOF_MASTODON_TAG=HHGoa2026
FACEPROOF_MASTODON_MAX_PAGES=5
FACEPROOF_MASTODON_PAGE_SIZE=40

# Fully local, reproducible Ethereum-compatible proof using Foundry Anvil.
# Start Anvil separately: anvil --chain-id 31337
FACEPROOF_RPC_URL=http://127.0.0.1:8545
FACEPROOF_CHAIN_ID=31337
FACEPROOF_SIGNER_MODE=unlocked
FACEPROOF_EXPECTED_SIGNER=
FACEPROOF_EXPLORER_TX_URL=

# Optional public-testnet profile (use a throwaway testnet key; never commit it):
# FACEPROOF_RPC_URL=https://your-sepolia-rpc.example
# FACEPROOF_CHAIN_ID=11155111
# FACEPROOF_SIGNER_MODE=private-key
# FACEPROOF_PRIVATE_KEY=0x...
# FACEPROOF_EXPLORER_TX_URL=https://sepolia.etherscan.io/tx/{tx_hash}

# Accuracy and bounded-search controls. Calibrate the final threshold on your own
# consented validation set before recording; 0.50 is a conservative project default.
FACEPROOF_DETECTION_THRESHOLD=0.80
FACEPROOF_FACE_THRESHOLD=0.50
FACEPROOF_PREFILTER_FACE_THRESHOLD=0.30
FACEPROOF_AMBIGUITY_MARGIN=0.05
FACEPROOF_PHASH_MAX_DISTANCE=12
FACEPROOF_AKAZE_MIN_INLIERS=10
FACEPROOF_AKAZE_MIN_INLIER_RATIO=0.25
FACEPROOF_MAX_CANDIDATES=200
FACEPROOF_MAX_FINALISTS=20
